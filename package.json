{
    "name": "question-bank-extractor",
    "version": "1.0.0",
    "description": "Extract questions and answers from PDF files and output as LaTeX",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "tsx src/index.ts",
        "dev": "tsx watch src/index.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "pdf",
        "latex",
        "question-bank",
        "extractor"
    ],
    "license": "MIT",
    "dependencies": {
        "@google/genai": "^1.0.0",
        "chalk": "^5.3.0",
        "commander": "^12.1.0",
        "dotenv": "^16.4.7",
        "js-tiktoken": "^1.0.15",
        "ora": "^8.1.1",
        "p-limit": "^6.1.0",
        "pdfjs-dist": "^4.9.155",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0",
        "vitest": "^2.1.0"
    }
}